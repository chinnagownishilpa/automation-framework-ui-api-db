<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Suite"
       parallel="methods"
       thread-count="5">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="API Tests">

        <classes>

            <class name="tests.api.AuthTokenTest"/>
            <class name="tests.api.CreateBookingTest"/>
            <class name="tests.api.GetBookingTest"/>
            <class name="tests.api.UpdateBookingTest"/>
            <class name="tests.api.DeleteBookingTest"/>
            <class name="tests.api.BookingFlowTest"/>
            <class name="tests.api.BookingSchemaValidationTest"/>

        </classes>

    </test>

</suite>